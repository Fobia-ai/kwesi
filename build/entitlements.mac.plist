<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Required for Electron apps with native addons and JIT compilation -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow unsigned executable memory for native modules and helper processes -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Disable library validation so Electron helper apps and native .node addons load -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Allow access to the microphone / audio input (future audio-recording features) -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Allow the app to read/write user-selected files outside the app sandbox -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Allow the app to run AppleScript/Automator if needed for OS integrations -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
  </dict>
</plist>
