{
  "name": "kwesi",
  "productName": "Kwesi",
  "version": "0.1.1",
  "description": "Local-first desktop app for generating and training open-source music models.",
  "author": "Fobia",
  "homepage": "https://github.com/Fobia-ai/kwesi",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fobia-ai/kwesi.git"
  },
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k -n VITE,ELECTRON -c blue,magenta \"vite\" \"wait-on tcp:5183 && cross-env NODE_ENV=development electron .\"",
    "build": "tsc -b && vite build",
    "build:electron": "tsc -p electron/tsconfig.json && tsc -p electron/tsconfig.preload.json",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --ext ts,tsx",
    "preview": "vite preview",
    "test": "vitest run",
    "prepackage": "npm run build && npm run build:electron",
    "package": "npm run prepackage && electron-builder --publish=never",
    "package:linux": "npm run prepackage && electron-builder --linux --publish=never",
    "package:mac": "npm run prepackage && electron-builder --mac --publish=never",
    "package:win": "npm run prepackage && electron-builder --win --publish=never"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "abcjs": "^6.7.0",
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tone": "^15.1.22",
    "undici": "^6.28.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2",
    "wait-on": "^8.0.1"
  }
}
