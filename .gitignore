node_modules
dist
dist-electron
release
.env
*.log
.DS_Store
*.tsbuildinfo

# Developer-only local staging area for model weights pulled by
# scripts/download_models.py before re-upload to Cloudflare R2.
/models
scripts/.venv
scripts/__pycache__

# Per-model Python virtual environments (KWESI_VENVS_DIR) -- large,
# machine-specific, reinstallable from servers/<model_id>/requirements.txt.
/venvs
**/__pycache__

# Vendored third-party inference code (github.com/microsoft/muzic), pulled in
# by Phase 7 -- not ours, reproducible via `git clone` (see each server's
# README), and large enough (musecoco/vendor alone is ~57MB) not to belong
# in this repo's own history.
servers/musecoco/vendor
servers/museformer/vendor

# Phase 8: ACE-Step's own repo, cloned whole rather than reimplemented as a
# third hand-written FastAPI wrapper — see servers/ace-step-1.5/README.md.
# Includes its own uv-managed .venv (kept separate from this app's own
# per-model $KWESI_VENVS_DIR/ace-step-1.5, which is where modelServer.ts
# actually looks for the interpreter it spawns) and the checkpoints/
# symlink modelServer.ts creates pointing back into KWESI_MODELS_DIR.
servers/ace-step-1.5/vendor
servers/yue2/vendor

# Phase 11: audiocraft's own real Hydra config/ tree (not shipped in the
# pip package — see servers/musicgen/README.md's "Training (Phase 11)"
# section), vendored just for training, plus per-run dset yaml files
# trainingManager.ts writes into config/dset/audio/ at training time.
servers/musicgen/vendor

# Claude Code harness internals, not project state.
.claude/

# Deployment scripts — local, interactive tooling not needed in the published repo.
scripts/deploy.sh

# Local social media draft content, not part of the shipped app.
social-post.txt

